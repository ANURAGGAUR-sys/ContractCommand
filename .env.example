# Copy this file to .env and fill in the values from Supabase > Connect.
# URL-encode special characters in the database password.
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@HOST:5432/postgres?sslmode=require

# Local development defaults. Set DEBUG=false and a strong secret in production.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-this-with-a-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
